{
  "id": "open-payments",
  "nombre": "Open Payments (riel de la natillera)",
  "proveedor": "interledger-open-payments",
  "urlBase": "https://natillera-bff.example/open-payments",
  "auth": {
    "esquema": "header",
    "nombreHeader": "X-Api-Key"
  },
  "headers": {
    "Accept": "application/json"
  },
  "gobierno": {
    "costoPorConsulta": 0,
    "moneda": "COP",
    "reintentosSegundos": [
      2,
      10,
      60
    ],
    "enfermaTrasFallosConsecutivos": 5,
    "zonaHoraria": "America/Bogota"
  },
  "datos": {
    "retenerRespuestaCruda": false,
    "retencionDias": 0,
    "pii": true
  },
  "operaciones": [
    {
      "id": "cobrar-cuota",
      "nombre": "Cobrar la cuota del periodo con el grant recurrente del participante",
      "metodo": "POST",
      "ruta": "/cobrar-cuota",
      "timeoutSegundos": 30,
      "mock": {
        "respuestas": [
          {
            "status": 200,
            "cuerpo": "{\"estado\":\"completado\",\"monto\":{{monto}},\"periodo\":{{periodo}}}"
          }
        ]
      }
    },
    {
      "id": "cobrar",
      "nombre": "Cobrar con el grant recurrente del participante (deuda + mora, obligaciones de actividades)",
      "metodo": "POST",
      "ruta": "/cobrar",
      "timeoutSegundos": 30,
      "mock": {
        "respuestas": [
          {
            "status": 200,
            "cuerpo": "{\"estado\":\"completado\",\"monto\":{{monto}}}"
          }
        ]
      }
    },
    {
      "id": "pagar",
      "nombre": "Pagar desde la cuenta de la natillera a una billetera (outgoing payment)",
      "metodo": "POST",
      "ruta": "/pagar",
      "timeoutSegundos": 30,
      "mock": {
        "respuestas": [
          {
            "status": 200,
            "cuerpo": "{\"estado\":\"completado\",\"monto\":{{monto}}}"
          }
        ]
      }
    },
    {
      "id": "desembolsar",
      "nombre": "Desembolsar un préstamo de la financiera a la billetera del participante",
      "metodo": "POST",
      "ruta": "/desembolsar",
      "timeoutSegundos": 30,
      "mock": {
        "respuestas": [
          {
            "status": 200,
            "cuerpo": "{\"estado\":\"completado\",\"monto\":{{monto}}}"
          }
        ]
      }
    }
  ]
}
