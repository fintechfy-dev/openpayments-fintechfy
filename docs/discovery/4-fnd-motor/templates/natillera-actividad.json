            },
            "natilleraId": {
              "type": "Concept",
              "concept": "NatilleraId"
            },
            "ganadorParticipacionId": {
              "type": "Concept",
              "concept": "GanadorParticipacionId"
            },
            "monto": {
              "type": "Concept",
              "concept": "RestoPremio"
            },
            "walletGanador": {
              "type": "Concept",
              "concept": "WalletGanador"
            }
          }
        }
