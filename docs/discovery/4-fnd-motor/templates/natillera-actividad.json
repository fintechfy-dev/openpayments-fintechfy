    {
      "name": "AcumularEnLiquidacion",
      "description": "BRG-026 (E7): sin ganador al liquidar → acumulado.",
      "trigger": "CerrarEnLiquidacion",
      "requiredStates": {
        "EstadoActividad": [
          "RECAUDANDO"
        ]
      },
      "steps": [
        {
