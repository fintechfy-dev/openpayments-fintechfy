# Servicio externo de lógica financiera (issue #5).
# Vacío = la web usa datos de prueba. Nunca uses el prefijo NEXT_PUBLIC_ para estas variables.
SERVICIO_URL=
SERVICIO_API_KEY=

# Inicio de sesión (demo). Nunca uses el prefijo NEXT_PUBLIC_ para estas variables.
# Secreto para firmar la cookie de sesión: al menos 32 caracteres al azar.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESION_SECRETO=
# Se entra con un código de 6 dígitos que llega por Telegram (OTP).
# Token del bot de Natillera: el mismo BOT_TOKEN de telegram/.env. La web solo envía mensajes.
# Vacío en desarrollo: el código se muestra en la terminal del servidor (nunca en producción).
TELEGRAM_BOT_TOKEN=
# Chat de Telegram de cada usuario de demo ("financiera" y "andres", administrador de Los Primos).
# Cada persona le escribe /start al bot una vez; el id del chat queda en el log del bot.
DEMO_FINANCIERA_TELEGRAM_CHAT_ID=
DEMO_ADMIN_TELEGRAM_CHAT_ID=
