# Copiar a telegram/.env y llenar. El archivo .env NUNCA se sube (está en .gitignore).
# Nunca pegues estos valores en un chat, un issue ni un PR.

# --- Bot de Telegram ---
# Token que entrega @BotFather (/newbot).
BOT_TOKEN=
# Chat del equipo: recibe alertas y es el único donde funciona /diag.
# Para saber el id, escríbele /start al bot desde ese chat y mira el log.
TEAM_CHAT_ID=

# --- Validaciones de rango que hace el bot (US-001-CFG) ---
# Límites del valor de la cuota, en la moneda de la Test Wallet.
CUOTA_MIN=
CUOTA_MAX=
# Porcentaje de mora diario máximo que puede poner un administrador (ej. 2.5).
MORA_DIARIA_MAX_PCT=

# --- Servicio externo de lógica financiera en staging (#5) ---
# URL y token (JWT de la organización) que da Willy. Las llamadas están en telegram/INTEGRACION.md.
# Sin URL, /crear termina en una vista previa y no llegan avisos. Con URL, todo lo de este bloque es obligatorio.
SERVICIO_EXTERNO_URL=
SERVICIO_EXTERNO_TOKEN=
# Reglas que el bot pone al crear cada natillera (US-001-CFG): días que se espera a completar el cupo,
# cuotas pagadas para poder pedir préstamo y cuántas veces lo ahorrado se puede prestar.
DIAS_ESPERA_CUPO=
PAGOS_PARA_PRESTAMO=
MULTIPLO_PRESTAMO=

# --- Índice de la web (opcional) ---
# El bot le avisa a la web cada natillera que crea. Los da Johan. Van juntas o ninguna.
WEB_INDICE_URL=
WEB_INDICE_API_KEY=

# --- Avisos de staging ---
# Déjala vacía. El flujo en vivo de staging solo trae cascadas entre contratos, sin los datos de los avisos,
# y POST /api/webhooks no existe en su puerta (404), así que `npm run registrar-avisos` no sirve.
# Los avisos de staging se le piden a la web (WEB_INDICE_URL) y los de pago a la API de pagos (PAGOS_URL):
# el código todavía no lo hace (#6, telegram/INTEGRACION.md).
AVISOS_PUERTO=

# --- Servicio de pagos (#4) ---
# URL del servicio de pagos, para iniciar el permiso de cada participante.
PAGOS_URL=

# --- Formulario de la Mini App (opcional) ---
# URL https de telegram/miniapp/ (GitHub Pages o un túnel). Sin ella, /crear pregunta todo en el chat.
# Ej.: https://fintechfy-dev.github.io/openpayments-fintechfy/telegram/miniapp/
MINIAPP_URL=

# --- Persistencia (opcional) ---
# Base de datos de las conversaciones del bot. Por defecto ./data/bot.db
# DB_PATH=./data/bot.db
