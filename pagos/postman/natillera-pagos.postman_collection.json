    {
      "name": "4. Lecturas del bot y la web",
      "description": "Solo lectura: el registro de pagos que muestra la web y los avisos de pago que pide el bot.",
      "item": [
        {
          "name": "Registro de pagos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKeyClientes}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registro"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "const pagos = pm.response.json();",
                  "pm.test(\"es una lista\", () => pm.expect(pagos).to.be.an(\"array\"));",
                  "const OPS = [\"cobrar-cuota\", \"cobrar\", \"pagar\", \"desembolsar\", \"pagar-con-permiso\", \"aportar-con-permiso\"];",
                  "pm.test(\"cada pago tiene operación, estado y sus cuatro etapas\", () => pagos.forEach((p) => { pm.expect(OPS).to.include(p.operacion); pm.expect([\"en-curso\", \"completado\", \"fallido\"]).to.include(p.estado); pm.expect(p.etapas).to.have.all.keys(\"solicitud\", \"autorizacion\", \"ejecucion\", \"finalizacion\"); }));",
                  "pm.test(\"lo debitado y lo recibido traen su moneda\", () => pagos.filter((p) => p.estado === \"completado\" && p.etapas.ejecucion && p.etapas.ejecucion.debitado).forEach((p) => [\"debitado\", \"recibido\"].forEach((k) => pm.expect(p.etapas.ejecucion[k]).to.include.keys(\"value\", \"assetCode\", \"assetScale\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Avisos de pago",
          "request": {
            "method": "GET",
            "header": [
