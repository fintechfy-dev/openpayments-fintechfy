                  "const avisos = pm.response.json();",
                  "pm.test(\"es una lista\", () => pm.expect(avisos).to.be.an(\"array\"));",
                  "pm.test(\"solo PagoCompletado o PagoFallido, con tipo, referencia y monto\", () => avisos.forEach((a) => { pm.expect([\"PagoCompletado\", \"PagoFallido\"]).to.include(a.evento); pm.expect(a.datos).to.include.keys(\"tipo\", \"referencia\", \"monto\"); }));",
                  "if (avisos.length) pm.collectionVariables.set(\"ultimoAviso\", avisos[avisos.length - 1].id);"
                ]
              }
            }
          ]
