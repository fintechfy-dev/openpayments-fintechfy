{
  "info": {
    "_postman_id": "22d2761c-02b0-5d81-82e8-b01030a61627",
    "name": "Natillera 2.0 · API de pagos",
    "description": "Pruebas de la API de pagos con Open Payments (`pagos/`), publicada en https://natillera-pagos.azurewebsites.net. Las carpetas 1 a 4 no mueven dinero y se pueden correr siempre; la 5 mueve dinero de la Test Wallet y se corre a mano. Ver `pagos/postman/README.md`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Salud y contrato",
      "description": "Rutas públicas. No cambian nada.",
      "item": [
        {
          "name": "Salud de la API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/salud",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "salud"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test(\"está configurada (ok)\", () => pm.expect(s.ok).to.eql(true));",
                  "pm.test(\"guarda en Azure Table Storage\", () => pm.expect(s.almacen).to.eql(\"tablas\"));",
                  "pm.test(\"tiene billetera del grupo y de la financiera\", () => { pm.expect(s.walletGrupo).to.match(/^https:\\/\\//); pm.expect(s.walletFinanciera).to.match(/^https:\\/\\//); });",
                  "pm.test(\"dice qué operaciones están simuladas\", () => pm.expect(s.simuladas).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Contrato OpenAPI",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/openapi.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "openapi.json"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "pm.test(\"es OpenAPI 3\", () => pm.expect(c.openapi).to.match(/^3\\./));",
                  "const rutas = [\"/api/salud\", \"/api/permisos\", \"/api/permisos/{permisoId}\", \"/api/permisos/{permisoId}/cancelar\", \"/api/permisos/{permisoId}/retorno\", \"/api/avisos\", \"/api/registro\"].concat([\"cobrar-cuota\", \"cobrar\", \"pagar\", \"desembolsar\", \"pagar-con-permiso\", \"aportar-con-permiso\"].map((o) => \"/api/open-payments/\" + o));",
                  "pm.test(\"documenta las 13 rutas\", () => rutas.forEach((r) => pm.expect(c.paths, r).to.have.property(r)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/docs/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "docs"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"es una página HTML con Swagger\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\"); pm.expect(pm.response.text().toLowerCase()).to.include(\"swagger\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
