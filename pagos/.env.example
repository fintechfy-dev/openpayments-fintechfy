# API de pagos de Natillera 2.0. Copiar a .env y llenar; .env nunca va al repositorio.
# En Azure, los mismos nombres van en la configuración de la App Service.
#
# Las llaves de Open Payments (billetera cliente, Key ID y llave privada) NO van aquí: llegan en cada
# llamada, en los encabezados X-OP-Wallet-Address, X-OP-Key-Id y X-OP-Private-Key (ver API.md).

# Dirección pública HTTPS de esta API (la usa la vuelta del permiso), sin "/" final.
URL_PUBLICA=

# Llave con la que staging llama a /api/open-payments/* (Willy la carga en el tenant).
API_KEY_STAGING=
# Llave con la que el bot y la web llaman a /api/permisos, /api/avisos y /api/registro.
API_KEY_CLIENTES=

# A dónde llegan cuotas, deuda, actividades y comisiones, y de dónde salen premios y liquidación.
OP_WALLET_GRUPO=
# De dónde salen los préstamos.
OP_WALLET_FINANCIERA=

# Conexión a Azure Table Storage. Vacía = memoria (se pierde todo al reiniciar; solo la laptop).
TABLA_CONEXION=

# Operaciones que responden 2xx sin mover dinero, marcadas como simuladas en el registro y en el aviso.
# Ejemplo: desembolsar,pagar-con-permiso
OPERACIONES_SIMULADAS=

PORT=3200
